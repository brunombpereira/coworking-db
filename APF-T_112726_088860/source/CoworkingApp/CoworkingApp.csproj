<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CoworkingApp</RootNamespace>
    <AssemblyName>CoworkingApp</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>disable</Nullable>
    <!-- LangVersion removido — usa C# 12 (default de net8). -->
    <!-- ApplicationManifest removido — DPI tratado em Program.cs. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- SqlClient: o legacy System.Data.SqlClient não vem em .NET 6+ -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- ConfigurationManager: deixou de ser in-box em .NET 6+ -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <!-- DataVisualization (Charting): community port; Microsoft nunca portou -->
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.0" />
    <!-- Icons FontAwesome (suporta .NET 8) -->
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <!-- PdfSharp (MIT) — geração de recibos PDF -->
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>
</Project>
