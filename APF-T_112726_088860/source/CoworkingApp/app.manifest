<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="CoworkingApp"/>

  <!--
    DPI awareness = System (process-wide). O app é renderizado ao DPI do
    monitor primário e fica nessa resolução para sempre. Quando arrastado
    para outro monitor com DPI diferente, o Windows faz bitmap-scaling —
    fica menos crisp, mas a layout NUNCA quebra.
    PerMonitorV2 em .NET Framework 4.8 + WinForms não é fiável para
    layouts com Size/Location absolutos (caso deste projecto).
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">System</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Compatibilidade — Windows 10/11 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
